#!/usr/sbin/nft -f

# Flush existing rules for this table to ensure clean state
flush table inet wg_route_panel 2>/dev/null || true

table inet wg_route_panel {
    # Sets for allowed IPs (managed dynamically by the panel via sudo)
    set dns_allow {
        type ipv4_addr
        flags interval
    }
    
    set dns_allow6 {
        type ipv6_addr
        flags interval
    }

    set socks_allow {
        type ipv4_addr
        flags interval
    }

    set socks_allow6 {
        type ipv6_addr
        flags interval
    }

    set panel_allow {
        type ipv4_addr
        flags interval
    }

    set panel_allow6 {
        type ipv6_addr
        flags interval
    }

    chain input {
        type filter hook input priority filter; policy drop;

        # Allow established and related connections
        ct state established,related accept

        # Allow loopback
        iifname "lo" accept

        # Allow SSH (adjust port 22 if your server uses a different port)
        tcp dport 22 accept

        # Allow WireGuard (default port 51820)
        udp dport 51820 accept

        # Panel access (restricted by panel_allow set)
        tcp dport 8080 ip saddr @panel_allow accept
        tcp dport 8080 ip6 saddr @panel_allow6 accept

        # DNS access (restricted by dns_allow set)
        udp dport 53 ip saddr @dns_allow accept
        tcp dport 53 ip saddr @dns_allow accept
        udp dport 53 ip6 saddr @dns_allow6 accept
        tcp dport 53 ip6 saddr @dns_allow6 accept

        # SOCKS5 access (restricted by socks_allow set)
        tcp dport 1080 ip saddr @socks_allow accept
        tcp dport 1080 ip6 saddr @socks_allow6 accept
    }
}
