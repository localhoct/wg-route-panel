table inet wg_route_panel {
 set dns_allow { type ipv4_addr; flags interval; elements = { 127.0.0.1 } }
 set dns_allow6 { type ipv6_addr; flags interval; elements = { ::1 } }
 set socks_allow { type ipv4_addr; flags interval; elements = { 127.0.0.1 } }
 set socks_allow6 { type ipv6_addr; flags interval; elements = { ::1 } }
 set panel_allow { type ipv4_addr; flags interval; elements = { 127.0.0.1 } }
 set panel_allow6 { type ipv6_addr; flags interval; elements = { ::1 } }
 set api_allow { type ipv4_addr; flags interval; elements = { 127.0.0.1 } }
 set api_allow6 { type ipv6_addr; flags interval; elements = { ::1 } }
 chain input {
  type filter hook input priority filter; policy accept;
  tcp dport 9090 ip saddr @panel_allow accept
  tcp dport 9090 ip saddr @api_allow accept
  tcp dport 9090 ip6 saddr @panel_allow6 accept
  tcp dport 9090 ip6 saddr @api_allow6 accept
  tcp dport 9090 drop
  tcp dport 1080 ip saddr != @socks_allow drop
  tcp dport 1080 ip6 saddr != @socks_allow6 drop
  udp dport 5353 ip saddr != @dns_allow drop
  tcp dport 5353 ip saddr != @dns_allow drop
  udp dport 5353 ip6 saddr != @dns_allow6 drop
  tcp dport 5353 ip6 saddr != @dns_allow6 drop
 }
}
