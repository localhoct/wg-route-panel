[Unit]
Description=Xray Core Service
After=network.target wg-quick@wg0.service

[Service]
Type=simple
User=wgpanel
Group=wgpanel
ExecStart=/usr/local/bin/xray run -config /etc/wg-route-panel/xray/config.json
Restart=on-failure
RestartSec=5s

# Security hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/wg-route-panel /var/log/wg-route-panel
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
