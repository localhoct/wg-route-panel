# Allow wgpanel user to manage specific services and nftables without a password
# THIS FILE IS MANAGED AUTOMATICALLY. DO NOT EDIT DIRECTLY.

wgpanel ALL=(root) NOPASSWD: /usr/bin/systemctl start wg-quick@wg0.service
wgpanel ALL=(root) NOPASSWD: /usr/bin/systemctl stop wg-quick@wg0.service
wgpanel ALL=(root) NOPASSWD: /usr/bin/systemctl restart wg-quick@wg0.service
wgpanel ALL=(root) NOPASSWD: /usr/bin/systemctl is-active wg-quick@wg0.service
wgpanel ALL=(root) NOPASSWD: /usr/bin/systemctl reload xray.service
wgpanel ALL=(root) NOPASSWD: /usr/bin/systemctl restart xray.service
wgpanel ALL=(root) NOPASSWD: /usr/sbin/wg show wg0
wgpanel ALL=(root) NOPASSWD: /usr/sbin/wg show wg0 latest-handshakes
wgpanel ALL=(root) NOPASSWD: /usr/sbin/wg show wg0 transfer
wgpanel ALL=(root) NOPASSWD: /usr/sbin/nft add element inet wg_route_panel *
wgpanel ALL=(root) NOPASSWD: /usr/sbin/nft delete element inet wg_route_panel *
wgpanel ALL=(root) NOPASSWD: /usr/sbin/nft flush set inet wg_route_panel *
